# --- LLM: any OpenAI-compatible API with tool calling ---
# Option A (default): Groq free tier, open models in the cloud. Free key: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-120b
# Optional for reasoning models like gpt-oss: low | medium | high
LLM_REASONING_EFFORT=low

# Option C: Google Gemini free tier (not open source). Free key: https://aistudio.google.com/apikey
# Set LLM_MODEL to a free "flash" model listed in AI Studio for your project.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIza...
# LLM_MODEL=<a gemini flash model id from AI Studio>
# LLM_REASONING_EFFORT=

# Option B: Ollama, runs on your own computer, no key, fully offline.
#   ollama pull qwen3:8b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen3:8b
# LLM_REASONING_EFFORT=

# --- Twilio (https://console.twilio.com) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Sandbox number shown in Twilio Console -> Messaging -> Try it out -> WhatsApp
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public URL Twilio reaches you at (e.g. your ngrok URL), used to verify requests
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
VALIDATE_TWILIO_SIGNATURE=true

# --- App ---
# Only these numbers may use the bot (comma separated). Leave empty to allow anyone.
ALLOWED_NUMBERS=whatsapp:+91XXXXXXXXXX
DEFAULT_CURRENCY=INR
TIMEZONE=Asia/Kolkata
DB_PATH=expenses.db
HISTORY_TURNS=6
# Secret for POST /cron/monthly-report (header: X-Cron-Secret)
CRON_SECRET=change-me
